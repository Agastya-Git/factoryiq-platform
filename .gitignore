# ─────────────────────────────────────────────────────────────────
# FactoryIQ – root .gitignore
# ─────────────────────────────────────────────────────────────────

# ── Secrets – NEVER commit these ─────────────────────────────────
.env
*.env

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
venv/
.venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
*.egg

# ── SQLite DB (factoryiq.db is retained for portable deployment) ──
*.db
!factoryiq.db
*.db.*
*.db-*
.runtime-db/
*.sqlite
*.sqlite3
*.bak
*.backup

# Local account directory contains plaintext credential examples.
ADMIN_SUPERVISOR_CREDENTIALS.md

# ── Node / Frontend ───────────────────────────────────────────────
node_modules/
project/node_modules/
project/dist/
project/dist-ssr/

# ── Logs ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS / IDE ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
